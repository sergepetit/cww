# Example: sbt credentials file for container use
# Place this file at <your-project>/.cww/sbt-credentials
#
# Then add to your .cww/docker-compose.services.yml:
#
# services:
#   coder:
#     volumes:
#       - ./.cww/sbt-credentials:/home/developer/.sbt/.credentials:ro
#
# SECURITY NOTE: Do not commit this file with real credentials!
# Consider using environment variables or a secrets manager instead.

realm=Sonatype Nexus Repository Manager
host=nexus.example.com
user=your-username
password=your-password

# For Artifactory:
# realm=Artifactory Realm
# host=artifactory.example.com
# user=your-username
# password=your-password-or-api-key
