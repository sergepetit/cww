#compdef cww
# zsh completion for cww — installed by install.sh.
#
# Commands and flags are hardcoded here (they ship with the CLI, so they can't
# drift from the installed version); workspace and agent names are dynamic,
# fetched via the hidden 'cww __complete <topic>' (fast: session files /
# the agent registry, no docker).

_cww_workspaces() {
  local -a names
  names=(${(f)"$(cww __complete workspaces 2>/dev/null)"})
  (( ${#names} )) && _describe -t workspaces 'workspace' names
}

_cww_agents() {
  local -a names
  names=(${(f)"$(cww __complete agents 2>/dev/null)"})
  (( ${#names} )) && _describe -t agents 'agent' names
}

# Remotes of the repo at the current directory (cheap: local git, no network).
_cww_remotes() {
  local -a names
  names=(${(f)"$(git remote 2>/dev/null)"})
  (( ${#names} )) && _describe -t remotes 'remote' names
}

# 'cww build' also accepts the literal 'all' besides the agent names.
_cww_build_targets() {
  local -a names
  names=(${(f)"$(cww __complete agents 2>/dev/null)"} all)
  _describe -t agents 'agent' names
}

# 'cww cp' arguments are host paths or '<workspace>:<path>' specs: offer
# workspace prefixes (colon kept, auto-removed if a space follows) alongside
# the usual filename completion.
_cww_cp_arg() {
  local -a names
  names=(${(f)"$(cww __complete workspaces 2>/dev/null)"})
  (( ${#names} )) && compadd -S ':' -q -- $names
  _files
}

# 'cww export-skill' takes a skill name from the host agent config dirs.
_cww_host_skills() {
  local -a names
  names=(${(f)"$(cww __complete host-skills 2>/dev/null)"})
  (( ${#names} )) && _describe -t skills 'skill' names
}

# 'cww auth' takes an agent name or the literal 'git'.
_cww_auth_targets() {
  local -a names
  names=(${(f)"$(cww __complete auth-targets 2>/dev/null)"})
  (( ${#names} )) && _describe -t targets 'target' names
}

# --method values depend on the agent given as the first positional.
_cww_auth_methods() {
  local -a names
  names=(${(f)"$(cww __complete auth-methods $words[2] 2>/dev/null)"})
  (( ${#names} )) && _describe -t methods 'method' names
}

# 'cww create --auth' — the agent may not be on the line yet, so offer every
# agent's method ids.
_cww_auth_methods_all() {
  local -a names
  names=(${(f)"$(cww __complete auth-methods-all 2>/dev/null)"})
  (( ${#names} )) && _describe -t methods 'method' names
}

_cww() {
  local -a commands=(
    'init:Set a repo up for cww (store git credential, preflight checks)'
    "auth:Store or renew an agent token / this repo's git credential"
    'create:Create a workspace (clones the repo, brings up services)'
    "teardown:Remove a workspace's containers, volumes, network, and metadata"
    "attach:Re-attach to a workspace's agent session"
    'shell:Open a plain login shell in a workspace (not the agent)'
    'start:Resume a stopped workspace (inverse of stop)'
    'stop:Stop a workspace (its filesystem is preserved)'
    "reset:Re-run the project's .cww/reset.sh (reset/reseed data)"
    'cp:Copy files between the host and a workspace (scp-style)'
    'export-skill:Export a personal skill from the host agent config into workspaces'
    'list:List all workspaces and how current their images are'
    "tunnel-command:Print the ssh command to reach a workspace's ports"
    'cache:Provision a shared dependency-cache dir (npm, m2, ...)'
    'build:Build/rebuild a per-agent Docker image with the current agent CLI'
    'help:Show the help message'
    'version:Show the version'
  )
  local -a help_opt=('(-h --help)'{-h,--help}'[show help]')

  local curcontext="$curcontext" state
  _arguments -C \
    '1:command:->command' \
    '*::arg:->args' && return

  case $state in
    command)
      _describe -t commands 'cww command' commands
      ;;
    args)
      case $words[1] in
        create)
          # --branch/--ref values are free-form: branch completion is
          # deliberately not offered (it would mean querying git per <TAB>).
          _arguments \
            '--branch[branch to check out inside the workspace]:ref:' \
            '--ref[alias for --branch]:ref:' \
            '--agent[coding agent to run in the workspace]:agent:_cww_agents' \
            "--auth[auth method the workspace's agent uses]:method:_cww_auth_methods_all" \
            '--remote[git remote whose URL the workspace clones]:remote:_cww_remotes' \
            '--no-attach[do not attach to tmux after creating]' \
            $help_opt \
            '1:project path or new workspace name:_directories' \
            '2:new workspace name:'
          ;;
        init)
          _arguments \
            '--remote[git remote to derive the clone URL from]:remote:_cww_remotes' \
            '--agent[agent whose auth/image to preflight]:agent:_cww_agents' \
            $help_opt \
            '1:project path:_directories'
          ;;
        auth)
          _arguments \
            "--method[which of the agent's auth methods to store]:method:_cww_auth_methods" \
            $help_opt \
            '1:agent, git, or KEY=VALUE:_cww_auth_targets'
          ;;
        teardown|down)
          _arguments \
            '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]' \
            $help_opt \
            '1:workspace:_cww_workspaces'
          ;;
        attach|shell|sh|start|stop|reset)
          _arguments $help_opt '1:workspace:_cww_workspaces'
          ;;
        cp)
          _arguments $help_opt '*:source or destination:_cww_cp_arg'
          ;;
        export-skill)
          _arguments \
            '--from[host agent config to take the skill from]:agent:_cww_agents' \
            '--copy[copy into .cww/skills instead of symlinking]' \
            $help_opt \
            '1:skill:_cww_host_skills' \
            '2:workspace:_cww_workspaces'
          ;;
        tunnel-command|tunnel)
          _arguments \
            '--host[SSH target to connect to]:target:' \
            $help_opt \
            '1:workspace:_cww_workspaces'
          ;;
        list|ls)
          _arguments \
            '--versions[also read each workspace'\''s agent CLI version]' \
            '--json[output as JSON]' \
            $help_opt
          ;;
        cache)
          _arguments \
            '--from[seed the cache from an existing directory]:directory:_directories' \
            $help_opt \
            '1:preset or custom cache name:(npm m2 ivy2 sbt coursier gradle)' \
            '2:container path (custom caches only):'
          ;;
        build)
          _arguments \
            '--cached[rebuild from the layer cache, keeping the installed CLI version]' \
            $help_opt \
            '1:agent:_cww_build_targets'
          ;;
      esac
      ;;
  esac
}

_cww "$@"
