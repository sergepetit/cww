# Generated by cww - do not edit manually
# This file is regenerated each time the task is started

services:
  coder:
    image: {{CWW_IMAGE}}
    container_name: {{CONTAINER_NAME}}
    hostname: {{CONTAINER_HOSTNAME}}
    stdin_open: true
    tty: true
    working_dir: /workspace
    # For the built-in browser stack (harmless when CWW_BROWSER=off): init
    # reaps Chrome's zombie processes, and headful Chrome needs more than the
    # 64MB /dev/shm compose default. Its noVNC port is published via the
    # generated docker-compose.browser.yml override, not here.
    init: true
    shm_size: "2gb"
    # Provides CWW_GIT_TOKEN (the developer's scoped git credential) to the
    # in-container credential helper. User-owned, mode 600.
    env_file:
      - path: {{HOME}}/.cww/env
        required: false
    environment:
      - TMUX_SESSION=main
      - CWW_WORKSPACE={{WORKSPACE_NAME}}
      - BRANCH_NAME={{BRANCH_NAME}}
      - REPO_URL={{REPO_URL}}
      - GIT_AUTHOR_NAME={{GIT_AUTHOR_NAME}}
      - GIT_AUTHOR_EMAIL={{GIT_AUTHOR_EMAIL}}
      - CWW_BROWSER={{CWW_BROWSER}}
      - TERM=xterm-256color
    # Nothing is mounted from the host: the repo is cloned into /workspace by
    # the entrypoint (self-contained .git), agent auth arrives via the env_file
    # (CLAUDE_CODE_OAUTH_TOKEN / MISTRAL_API_KEY), and the agent's onboarding
    # stub + settings are baked into the per-agent image.
