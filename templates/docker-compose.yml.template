# Generated by cww - do not edit manually
# This file is regenerated each time the task is started

services:
  coder:
    image: {{CWW_IMAGE}}
    container_name: {{CONTAINER_NAME}}
    hostname: {{CONTAINER_HOSTNAME}}
    stdin_open: true
    tty: true
    working_dir: /workspace
    # For the built-in browser stack (harmless when CWW_BROWSER=off): init
    # reaps Chrome's zombie processes, and headful Chrome needs more than the
    # 64MB /dev/shm compose default. Its noVNC port is published via the
    # generated docker-compose.browser.yml override, not here.
    init: true
    shm_size: "2gb"
    # Env for the container, in increasing order of precedence (compose: a
    # later env_file wins). The three optional services layers — machine-wide,
    # per-project, per-workspace — are the pass-through for anything the app's
    # own services need; everything in them reaches this container verbatim.
    # The task-dir env comes last so a services file can never shadow a
    # credential: written by 'cww create' (user-owned, mode 600), it carries
    # exactly two — this repo's git token from ~/.cww/credentials, and the
    # single key of the workspace's chosen auth method from ~/.cww/env, never
    # the whole global env file.
    env_file:
      - path: {{HOME}}/.cww/services.env
        required: false
      - path: {{PROJECT_SERVICES_ENV}}
        required: false
      - path: {{WORKSPACE_SERVICES_ENV}}
        required: false
      - path: {{TASK_DIR}}/env
        required: false
    environment:
      - TMUX_SESSION=main
      - CWW_WORKSPACE={{WORKSPACE_NAME}}
      - BRANCH_NAME={{BRANCH_NAME}}
      - REPO_URL={{REPO_URL}}
      - GIT_AUTHOR_NAME={{GIT_AUTHOR_NAME}}
      - GIT_AUTHOR_EMAIL={{GIT_AUTHOR_EMAIL}}
      - CWW_BROWSER={{CWW_BROWSER}}
      - CWW_BROWSER_RESOLUTION={{CWW_BROWSER_RESOLUTION}}
      - TERM=xterm-256color
    # Nothing is mounted from the host: the repo is cloned into /workspace by
    # the entrypoint (self-contained .git), agent auth arrives via the
    # task-dir env_file (the chosen method's key, e.g. CLAUDE_CODE_OAUTH_TOKEN),
    # and the agent's onboarding stub + settings are baked into the per-agent
    # image.
