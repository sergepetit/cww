{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "lsp": true,
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "chrome-devtools-mcp",
        "--browser-url=http://127.0.0.1:9222",
        "--usage-statistics=false"
      ],
      "enabled": true
    }
  }
}
